# Copy to .env and change the passwords before deploying
MYSQL_DATABASE=expense_tracker
MYSQL_USER=expense_user
MYSQL_PASSWORD=change_me_please
MYSQL_ROOT_PASSWORD=change_me_root_please

# Port the website is published on (80 = http://your-server/)
APP_PORT=80

# Origins allowed to call the API directly (not needed when using the bundled nginx)
CORS_ALLOWED_ORIGINS=http://localhost

# Set to false to hide Swagger UI in production
SWAGGER_ENABLED=true

# Frontend display options (used at image build time)
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
